# ==============================================================================
# جمعية تطوير بيت لاهيا (BLDA) - متغيرات البيئة للربط مع Supabase و Vercel
# قم بنسخ هذا الملف إلى .env.local واستبدال القيم بمفاتيح مشروعك في Supabase
# ==============================================================================

# 1. رابط مشروعك في Supabase (Project URL)
NEXT_PUBLIC_SUPABASE_URL=https://xyzcompany.supabase.co

# 2. المفتاح العام المجهول (anon public key)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
